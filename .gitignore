# Build & tooling
node_modules/
*.log
*.tmp

# Regenerable audit output and screenshots
# (Verification evidence lives in %LOCALAPPDATA%\WorkBuddyDreamSkin and can be
# reproduced by re-running verify/audit scripts. Keeping ~100 MB of PNGs out
# of git history keeps clones fast; promote individual keeper shots by force-
# adding them: git add -f artifacts/<name>.png)
artifacts/
tmp/

# Original AI-generated hero source images (multi-MB PNGs). The shipped
# palette-driven versions live under assets/theme-presets/<name>/*.jpg
# (compressed q88). Legacy Pictures/1-3.png stay tracked for backwards
# compatibility; new source PNGs are kept local only.
Pictures/*.png
!Pictures/1.png
!Pictures/2.png
!Pictures/3.png

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Local secrets (defensive — none checked in today)
.env
.env.*
!.env.example
